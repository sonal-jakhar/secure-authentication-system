# Copy this file to .env and fill in values locally.
# Do not commit .env. These placeholders are not real secrets.

# Fernet key (url-safe base64, 32-byte key) used later to encrypt TOTP secrets.
# Generate in a later phase. Leave empty for now.
FERNET_KEY=

# Optional application secret for future session handling.
APP_SECRET_KEY=

# SQLite database path (file itself is gitignored).
DATABASE_PATH=data/users.db
